<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="450"
        x:Class="MsoPractical2.GUI.MainWindow"
        Title="MsoPractical2.GUI">
    <Grid RowDefinitions="Auto, Auto, *, Auto" ShowGridLines="True" Background="White">
        <!-- Title bar -->
        <Grid Grid.Row="0" Background="Blue" Height="30">
            <Label VerticalAlignment="Center" HorizontalAlignment="Center">
                GRID PROGRAMMER
            </Label>
        </Grid>
        <!-- Command bar -->
        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto,">
            <Button Grid.Column="0" Background="Purple">
                Import
            </Button>
            <Button Grid.Column="2" Background="LightBlue">
                Move
            </Button>
            <Button Grid.Column="3" Background="LightBlue">
                Turn
            </Button>
            <Button Grid.Column="4" Background="LightBlue">
                Jump
            </Button>
            <Button Grid.Column="5" Background="LightBlue">
                Repeat
            </Button>
            <Button Grid.Column="6" Background="LightBlue">
                RepeatUntil
            </Button>
        </Grid>
        <!-- grid/programbuilder -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">

        </Grid>
        <!-- console -->
        <Grid Grid.Row="3" Height="80">
            
        </Grid>
    </Grid>
</Window>
